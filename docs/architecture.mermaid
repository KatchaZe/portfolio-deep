flowchart TD
    subgraph SRC["1 · SOURCE ADAPTERS  (fetch only, mockable)"]
        SEC["sec_edgar.py  ★PRIMARY★<br/>financials: robust TTM (FY+YTD−priorYTD)<br/>+ CFO/assets/AR/interest/R&D/acq/deferred rev<br/>quarterly rev & op-income & EPS · freshest-tag · FX-aware<br/>disk cache 12h + stale-cache fallback (H1)"]
        FMP["fmp.py<br/>profile: sector·beta·price · earnings (EPS+Rev surprise) · quote<br/>analyst-estimate path · quarterly estimates · peers<br/>adjClose history (momentum tier-2 + risk) · free-tier caps (limit≤5)"]
        YH["yahoo.py<br/>forward EPS (adj) · momentum chart · 5y prices<br/>EPS surprise · revenue est (curQ) · ^TNX · FX<br/>cached session+crumb (P2) · retry + host rotation"]
        STQ["stooq.py<br/>free daily OHLC (no key)<br/>price/momentum + risk-returns FALLBACK"]
        FH["finnhub.py / alphavantage.py<br/>optional 3rd/4th EPS-surprise cross-check"]
    end

    subgraph PIPE["2 · PIPELINE"]
        NORM["normalize.py<br/>merge SEC + FMP + Yahoo → FinancialFacts (+FX, provenance)"]
        VAL["validate.py<br/>sanity rules · forward-EPS resolution<br/>assumption flags → confidence score + tier (🟢🟡🔴)"]
        TRACKS["rev_track · margin_track · consensus<br/>surprise_backfill · pricecache (R4)<br/>EPS/Rev/Margin track record + EPS blend"]
        MKTV["market_valuation.py<br/>S32/33 overlay: implied ERP band →<br/>cheap/fair/expensive + tilt (no on/off timing)"]
        SCRN["screen.py<br/>S13/S19 GARP: cheap × quality rank"]
        RISKP["prices.py — ALL price ladders (2026-07-19)<br/>momentum short (yahoo→stooq) · long (yahoo→fmp→stooq +pricecache)<br/>risk returns FMP→Stooq→proxy · no-poison daily cache<br/>+ risk_report.py: /api/risk payload builder (injectable seam)"]
        REF["refresh.py (orchestration)<br/>fetch/commit_fundamentals · fetch/commit_daily (PARALLEL, P1: 4 workers)<br/>watchlist · allocation · portfolio_view · _earn_status (why-empty)"]
    end

    subgraph DOM["3 · DOMAIN  (pure · deterministic · tested)"]
        FACTS["FinancialFacts<br/>values + provenance + confidence<br/>+ v8.2 fields (CFO, R&D, consensus path, peers…)"]
        MOM["momentum.py ★PRIMARY signal★<br/>MOM_12_1 · ROC_6M · SMA200 · RSI(14) → composite<br/>+ S9: reversal_flag (3-5y) · market_state (SPY vs 200-DMA) · crash_guard"]
        IND["indicators.py (secondary)<br/>RSI / MACD / DBBMV mean-reversion + Action grid (S11 taxonomy)"]
        ADV["advice.py (v8.3, Thai)<br/>Damodaran action synthesis:<br/>VALUE → QUALITY → TIMING → Action"]
        EXT["pead.py (S25 drift) · costs.py (S6 net) · philosophy.py (S1/S42 fit)<br/>diversification.py (per-portfolio diversification philosophy S2-4/S35-41)"]
        subgraph ENG["engine/  (versioned, swappable)"]
            CON["contract.py<br/>Valuation + DeepEngine ABC"]
            V82["deep_v82.py  ★active★<br/>true WACC·Ke·R&D-ROIC·EQ·2-stage PEG·FVP·EV RevDCF·rubric"]
            V73["deep_v73.py  (rollback)"]
            REG["__init__.py registry<br/>get_engine(DEEP_VERSION=8.2)"]
        end
        RISK["engine/risk.py (Risk Desk math)<br/>weights·cov·DR·RC/ENB·stress·VaR·downside(S2/S4)<br/>rate_stress(S3)·sizing·rebalance<br/>correlation monitor: pair/sector/downside/rolling corr"]
    end

    subgraph STORE["4 · STORE  (store.py local JSON · store_sync.py cloud mirror)"]
        PORT["portfolio.json (local working copy)<br/>holdings(shares+avg cost) · watchlist<br/>facts · results · momentum · market(^regime) · fmp_usage<br/>rev_snapshots · rev_surprises (accrue)"]
        RCACHE["risk_cache.json<br/>risk return-series cache (separate file)"]
        GD["gdrive_store.py<br/>OAuth user creds · scope drive.file<br/>drive_pull() on load · background push worker<br/>★PUSH GUARD★: push BLOCKED until a pull succeeds<br/>(protects backup from an empty cold-start store)"]
        CLOUD["☁ Google Drive (your account)<br/>portfolio.json — survives Render<br/>free-tier redeploys / cold starts"]
    end

    subgraph API["5 · FASTAPI (app.py)"]
        EP["/portfolio /holding(+/remove) /refresh /daily<br/>/watchlist(/add /remove /run /promote)<br/>/allocation(/whatif) /risk /screen /persist /quota /healthz"]
    end

    subgraph UI["6 · DASHBOARD (index.html, 6 tabs · build stamp guard)"]
        T0["Command strip (ทุกแท็บ)<br/>Regime S9 · Market value S32/33 · vs S&P S16/S35 · Philosophy S1/S42<br/>+ 🧭 synthesis line · stale-assumption banner · 💾 persist badge + keepalive"]
        T1["Tab 1 · My Portfolio (cards)<br/>value gauge (Price vs Value) · DEEP★ + Moat/EQ/GARP chips<br/>Momentum/Rank/Action · Anchor FV (ทุกวิธี+★) · net upside (S6)<br/>earnings circles EPS+Rev+Mgn + PEAD · 💡 advice · drawer (WACC/Ke/EVA)"]
        T2["Tab 2 · Watchlist<br/>same cards, run on-demand · + Portfolio · remove"]
        T3["Tab 3 · Allocation<br/>Cash stance · GARP screen + quadrant → RISK DESK:<br/>Portfolio Story · %Capital vs %Risk · concentration · stress/VaR<br/>downside S2/S4 · suitability · rebalance · (cost pies + what-if)"]
        T6["Tab 6 · Correlation (S2-4/S35-41) · reuses /api/risk · Normal/Crisis toggle<br/>Diversification Philosophy: ENB/EffN · fragility ΔENB · 6 pillars · story · A1 Cap-vs-Risk<br/>ticker heatmap · sector summary · top pairs · Benchmark+Asset (SPY/QQQ/GLD/IBIT) · rolling corr"]
        T4["Tab 4 · How to — annotated SVG mockups ของ card / banner / allocation + Correlation<br/>Tab 5 · Ref — นิยามครบ: Damodaran terms · S1–S42 · Correlation/Diversification · ตัวย่อ/สัญลักษณ์"]
    end

    SEC --> NORM
    FMP --> NORM
    YH --> NORM
    STQ -. price/return fallback .-> REF
    FH -. optional cross-check .-> TRACKS
    NORM --> VAL --> FACTS
    FACTS --> CON
    CON --- V82
    CON --- V73
    REG --> CON
    REF --> FACTS
    REF --> MOM
    REF --> IND
    REF --> REG
    REF --> TRACKS
    REF --> MKTV
    REF --> SCRN
    REF --> ADV
    REF --> EXT
    TRACKS --> PORT
    REF --> PORT
    PORT --> EP
    RISKP --> RISK
    RISK --> EP
    RISKP -. caches .-> RCACHE
    PORT -. read-only .-> RISK
    PORT -. "background push (guarded)" .-> GD
    GD -. "drive_pull() on load" .-> PORT
    GD <-->|sync| CLOUD
    EP --> T0
    EP --> T1
    EP --> T2
    EP --> T3
    YH -. daily momentum (no FMP quota) .-> REF
    QUOTA["quota guard<br/>FMP 250/day · ~5 calls/ticker (fundamentals)<br/>partitioned UP FRONT for parallel fetch · warn 90%"]
    QUOTA -. guards .-> REF
    QUOTA -. guards .-> RISKP
    FIX["tests/fixtures<br/>AVGO ABBV ORCL NVO MSFT"]
    FIX -. freezes correct values .-> NORM

    classDef primary fill:#dcfce7,stroke:#16a34a,stroke-width:2px;
    classDef data fill:#dbeafe,stroke:#2563eb;
    classDef guard fill:#fef9c3,stroke:#ca8a04;
    classDef cloud fill:#ede9fe,stroke:#7c3aed,stroke-width:2px;
    class SEC primary;
    class FMP,YH,STQ,FH,FACTS data;
    class VAL,QUOTA,FIX guard;
    class GD,CLOUD,RCACHE cloud;
